{
  "name": "tarot-threejs-mp",
  "version": "1.0.0",
  "type": "module",
  "description": "A tarot card drawing game using Three.js and MediaPipe Tasks Vision for gesture recognition.",
  "main": "index.html",
  "scripts": {
    "predev": "node scripts/prepare-mediapipe-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-mediapipe-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "acceptance:smoke": "npm run build && node scripts/verify-acceptance.mjs",
    "check": "npm run lint && npm run test:run && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/three": "^0.181.0",
    "eslint": "^9.39.5",
    "jsdom": "^27.4.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "tarot",
    "threejs",
    "mediapipe",
    "gesture",
    "game"
  ],
  "author": "Fengfengex",
  "license": "MIT"
}
